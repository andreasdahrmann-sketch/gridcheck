// GridCheck Type Definitions

export interface ProjectInput {
  // Standort
  plz: string;
  ort: string;
  strasse: string;
  flurstueck: string;
  bundesland: string;
  
  // Anschlussparameter
  anschlussleistung_kw: number;
  spannungsebene: 'NS' | 'MS' | 'HS' | 'HöS';
  anschlussart: 'Einspeisung' | 'Bezug' | 'Bidirektional';
  erzeugungstyp?: 'PV' | 'Wind' | 'BESS' | 'BioGas' | 'Hybrid' | 'Keine';
  
  // Zusatzinfos
  cos_phi: number;
  gleichzeitigkeitsfaktor: number;
  einspeiseleistung_kw?: number;
  bezugsleistung_kw?: number;
  speicherkapazitaet_kwh?: number;
  
  // Meta
  projektname: string;
  projektierer: string;
  datum: string;
}

export interface NetzAnalyse {
  // Ergebnis
  machbar: boolean;
  einschraenkungen: string[];
  empfehlungen: string[];
  
  // Technische Bewertung
  kurzschlussleistung_mva: number;
  thermische_auslastung_prozent: number;
  spannungsaenderung_prozent: number;
  n1_sicher: boolean;
  
  // Netzverknüpfungspunkt
  nvp_bezeichnung: string;
  nvp_entfernung_km: number;
  nvp_freie_kapazitaet_kw: number;
  
  // Kosten-Indikation
  kosten_indikation_eur: number;
  kostenklasse: 'gering' | 'mittel' | 'hoch' | 'sehr_hoch';
  
  // Zeitrahmen
  geschaetzte_bearbeitungszeit_wochen: number;
  netzausbau_erforderlich: boolean;
  
  // Score
  score: number; // 0-100
  konfidenz: number; // 0-100
}

export interface CheckResult {
  id: string;
  input: ProjectInput;
  analyse: NetzAnalyse;
  timestamp: string;
  version: string;
  status: 'berechnet' | 'validiert' | 'abgelehnt';
  
  // Revisionssicherheit
  hash: string;
  bearbeiter: string;
}

export type SpannungsebeneGrenzen = {
  [key in ProjectInput['spannungsebene']]: {
    min_kw: number;
    max_kw: number;
    typisch_kw: string;
  };
};
