{
  "version": "1.0.0",
  "fieldTypes": {
    "projectName": "string",
    "applicantName": "string",
    "connectionLevel": "string",
    "requestedCapacityKw": "number",
    "estimatedAvailableCapacityKw": "number",
    "loadProfileKnown": "boolean",
    "siteSecured": "boolean"
  },
  "requiredFields": [
    "projectName",
    "applicantName",
    "connectionLevel",
    "requestedCapacityKw",
    "estimatedAvailableCapacityKw"
  ],
  "allowedConnectionLevels": ["LV", "MV", "HV"],
  "rules": [
    {
      "id": "REQ_001",
      "type": "required",
      "field": "projectName",
      "message": "projectName fehlt"
    },
    {
      "id": "REQ_002",
      "type": "required",
      "field": "applicantName",
      "message": "applicantName fehlt"
    },
    {
      "id": "REQ_003",
      "type": "required",
      "field": "connectionLevel",
      "message": "connectionLevel fehlt"
    },
    {
      "id": "REQ_004",
      "type": "required",
      "field": "requestedCapacityKw",
      "message": "requestedCapacityKw fehlt"
    },
    {
      "id": "REQ_005",
      "type": "required",
      "field": "estimatedAvailableCapacityKw",
      "message": "estimatedAvailableCapacityKw fehlt"
    },
    {
      "id": "VAL_001",
      "type": "enum",
      "field": "connectionLevel",
      "allowed": ["LV", "MV", "HV"],
      "message": "connectionLevel ungültig"
    },
    {
      "id": "VAL_002",
      "type": "number_min",
      "field": "requestedCapacityKw",
      "min": 0.0001,
      "message": "requestedCapacityKw muss > 0 sein"
    },
    {
      "id": "VAL_003",
      "type": "number_min",
      "field": "estimatedAvailableCapacityKw",
      "min": 0,
      "message": "estimatedAvailableCapacityKw muss >= 0 sein"
    },
    {
      "id": "WARN_001",
      "type": "warning_if_false",
      "field": "loadProfileKnown",
      "message": "Lastprofil unbekannt"
    },
    {
      "id": "WARN_002",
      "type": "warning_if_false",
      "field": "siteSecured",
      "message": "Standort nicht gesichert"
    }
  ]
}
