APP_ENV=dev
APP_VERSION=v0.0.0-local
# Lokal mit docker-compose: Host-Port 5433, Credentials wie in docker-compose.yml
DATABASE_URL=postgresql+psycopg2://gridcheck:gridcheck_dev_2026@localhost:5433/gridcheck
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional fuer temporaere Deploy-Hosts:
# - Vercel Preview: CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$
# - Railway Temporary: CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.up\.railway\.app$
LOG_LEVEL=INFO
JWT_SECRET=replace-with-random-32-plus-char-secret
JWT_REFRESH_SECRET=replace-with-second-random-32-plus-char-secret
# Ohne diese Zeile: dev=Legacy an, staging/prod=Legacy aus. Explizit: true | false
# ENABLE_LEGACY_ROUTES=true
TRUSTED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://localhost:6379/0
AUTH_ACCESS_COOKIE=gridcheck_access
AUTH_REFRESH_COOKIE=gridcheck_refresh
AUTH_CSRF_COOKIE=gridcheck_csrf
FREE_CHECKS_LIMIT=3
AUTO_CREATE_SCHEMA=false
PROJECT_UPLOAD_DIR=./uploads
SITE_MARKER_UPLOAD_DIR=./uploads/site_markers
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_BASIC_ID=
STRIPE_PRICE_PREMIUM_ID=
STRIPE_PRICE_PROFESSIONAL_ID=
STRIPE_PRICE_PRO_LICENSE_ID=
STRIPE_PRICE_EXPRESS_ID=
# Fuer lokale echte Stripe-Tests ausschliesslich Testmode-Werte verwenden (sk_test / pk_test / price_ / whsec_).
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/settings?billing=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/settings?billing=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/settings
# E-Mail (transaktional + Kontaktformular)
RESEND_API_KEY=
EMAIL_FROM=noreply@gridcheck.de
EMAIL_SEND_WELCOME=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=mailer@example.com
CONTACT_SMTP_PASSWORD=replace-me
CONTACT_TO_EMAIL=kontakt@gridcheck.de
PASSWORD_RESET_BASE_URL=http://localhost:3000
PASSWORD_RESET_TTL_MIN=60
# SENTRY_DSN=
EMAIL_FROM=noreply@gridcheck.de
PASSWORD_RESET_BASE_URL=http://localhost:3000
# OSM / Overpass (optional, Netzplan-Nahbauten)
# OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSM_FETCH_TIMEOUT_SEC=25
# OSM_RATE_LIMIT_PER_MIN=6
# OSM_NEARBY_CACHE_TTL_SEC=300
