APP_ENV=staging
APP_VERSION=v0.1.0-rc
DATABASE_URL=postgresql+psycopg2://gridcheck:replace-me@staging-db-host:5432/gridcheck
# Fuer Vercel Preview-Deploys ohne eigene Domain:
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$
# Alternativ exakte Frontend-URL setzen:
# CORS_ORIGINS=https://staging.gridcheck.de
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$
LOG_LEVEL=INFO
JWT_SECRET=replace-with-random-32-plus-char-secret
JWT_REFRESH_SECRET=replace-with-second-random-32-plus-char-secret
ENABLE_LEGACY_ROUTES=false
TRUSTED_HOSTS=*.up.railway.app,*.vercel.app,localhost,127.0.0.1
REDIS_URL=redis://staging-redis:6379/0
AUTH_ACCESS_COOKIE=gridcheck_access
AUTH_REFRESH_COOKIE=gridcheck_refresh
AUTH_CSRF_COOKIE=gridcheck_csrf
FREE_CHECKS_LIMIT=3
AUTO_CREATE_SCHEMA=false
# Keine ephemere Container-FS fuer Uploads: Volume oder Shared Storage vorsehen.
PROJECT_UPLOAD_DIR=/var/lib/gridcheck/uploads
SITE_MARKER_UPLOAD_DIR=/var/lib/gridcheck/uploads/site_markers
## Staging laeuft gegen Stripe Testmode, nie gegen Live-Keys.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_PRICE_BASIC_ID=price_basic_replace_me
STRIPE_PRICE_PREMIUM_ID=price_premium_replace_me
STRIPE_PRICE_PROFESSIONAL_ID=price_professional_replace_me
STRIPE_PRICE_PRO_LICENSE_ID=price_pro_license_replace_me
STRIPE_PRICE_EXPRESS_ID=price_express_replace_me
STRIPE_CHECKOUT_SUCCESS_URL=https://your-frontend.vercel.app/settings?billing=success
STRIPE_CHECKOUT_CANCEL_URL=https://your-frontend.vercel.app/settings?billing=cancel
STRIPE_PORTAL_RETURN_URL=https://your-frontend.vercel.app/settings
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=mailer@example.com
CONTACT_SMTP_PASSWORD=replace-me
CONTACT_TO_EMAIL=kontakt@gridcheck.de
