from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session
from db.database import get_db
from db.models import Project, CheckResult, AuditLog, make_checksum
from engine import berechne_netzcheck
from pydantic import BaseModel
from typing import Optional
import json

router = APIRouter()


class ProjectCreate(BaseModel):
    name: str
    plz: str
    ort: Optional[str] = None
    typ: str
    leistung_kw: float
    spannung_kv: Optional[float] = None
    einspeiseart: Optional[str] = "Volleinspeisung"
    skv_mva: Optional[float] = None
    bestehende_einspeisung_kw: Optional[float] = 0
    leitungstyp: Optional[str] = "NAYY 150"
    leitungslaenge_km: Optional[float] = 1.0


@router.post("/api/check")
def run_check(data: ProjectCreate, db: Session = Depends(get_db)):
    project = Project(**data.dict())
    db.add(project)
    db.commit()
    db.refresh(project)

    result = berechne_netzcheck(
        typ=data.typ,
        leistung_kw=data.leistung_kw,
        plz=data.plz,
        spannung_kv=data.spannung_kv,
        skv_mva=data.skv_mva,
        bestehende_einspeisung_kw=data.bestehende_einspeisung_kw,
        leitungstyp=data.leitungstyp,
        leitungslaenge_km=data.leitungslaenge_km,
    )

    check = CheckResult(
        project_id=project.id,
        score=result["score"],
        spannungsband_ok=result["spannungsband_ok"],
        thermische_auslastung_ok=result["thermische_auslastung_ok"],
        kurzschluss_ok=result["kurzschluss_ok"],
        n1_ok=result["n1_ok"],
        netzebene=result["netzebene"],
        empfehlung=result["empfehlung"],
        details=json.dumps(result["details"], default=str),
    )
    db.add(check)
    db.commit()

    audit = AuditLog(
        project_id=project.id,
        action="CHECK_CREATED",
        detail=json.dumps(result, default=str),
        checksum=make_checksum(result),
    )
    db.add(audit)
    db.commit()

    return {"project_id": project.id, **result}


@router.get("/api/result/{project_id}")
def get_result(project_id: int, db: Session = Depends(get_db)):
    check = db.query(CheckResult).filter(CheckResult.project_id == project_id).first()
    if not check:
        raise HTTPException(status_code=404, detail="Projekt nicht gefunden")
    return {
        "project_id": check.project_id,
        "score": check.score,
        "spannungsband_ok": check.spannungsband_ok,
        "thermische_auslastung_ok": check.thermische_auslastung_ok,
        "kurzschluss_ok": check.kurzschluss_ok,
        "n1_ok": check.n1_ok,
        "netzebene": check.netzebene,
        "empfehlung": check.empfehlung,
        "details": json.loads(check.details) if check.details else {},
    }


@router.get("/api/audit/{project_id}")
def get_audit(project_id: int, db: Session = Depends(get_db)):
    logs = db.query(AuditLog).filter(AuditLog.project_id == project_id).all()
    if not logs:
        raise HTTPException(status_code=404, detail="Keine Audit-Logs gefunden")
    return [
        {
            "id": l.id,
            "timestamp": str(l.timestamp),
            "action": l.action,
            "detail": l.detail,
            "checksum": l.checksum,
        }
        for l in logs
    ]


@router.get("/api/projects")
def list_projects(db: Session = Depends(get_db)):
    projects = db.query(Project).order_by(Project.created_at.desc()).all()
    return [
        {
            "id": p.id,
            "name": p.name,
            "plz": p.plz,
            "ort": p.ort,
            "typ": p.typ,
            "leistung_kw": p.leistung_kw,
            "created_at": str(p.created_at),
        }
        for p in projects
    ]
# C:\Users\andre\gridcheck\backend\api\routes.py
from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session
from db.database import get_db
from db.models import Project, CheckResult, AuditLog, make_checksum
from engine import berechne_netzcheck
from pydantic import BaseModel
from typing import Optional
import json

router = APIRouter()


class AnalyzeRequest(BaseModel):
    # Step 1 - Projektdaten
    projektname: str
    plz: str
    anlagentyp: str = "pv"
    leistung_kw: float
    spannungsebene: str = "20"
    cos_phi: float = 0.95
    einspeiseart: str = "volleinspeisung"
    speicher: bool = False
    speicher_kwh: Optional[float] = None
    koordinaten_lat: Optional[float] = None
    koordinaten_lon: Optional[float] = None
    inbetriebnahme: Optional[str] = None
    kontakt_name: Optional[str] = None
    kontakt_email: Optional[str] = None
    kontakt_firma: Optional[str] = None
    # Step 2 - Netzparameter
    trafo_mva: float = 0.63
    leitungslaenge_km: float = 1.0
    leitungstyp: str = "NAYY"
    querschnitt_mm2: str = "150"
    netzverknuepfungspunkt: str = ""
    skv_mva: Optional[float] = None
    parallelsysteme: int = 1
    eigentumsgrenze: str = "HAK"
    vorbelastung_mw: Optional[float] = None
    netz_typ: str = "kabel"


def resolve_cable_key(leitungstyp: str, querschnitt: str) -> str:
    """Baut aus Frontend-Feldern den CABLE_DATABASE-Key zusammen."""
    from constants import CABLE_DATABASE
    # Versuch 1: Direkt zusammensetzen
    key = f"{leitungstyp} {querschnitt}"
    if key in CABLE_DATABASE:
        return key
    # Versuch 2: Mit "SE" Suffix (z.B. NAYY 150SE)
    key_se = f"{leitungstyp} {querschnitt}SE"
    if key_se in CABLE_DATABASE:
        return key_se
    # Versuch 3: NA2XS2Y Varianten
    key_na = f"NA2XS2Y {querschnitt}"
    if key_na in CABLE_DATABASE:
        return key_na
    # Fallback: erstbestes Kabel mit passendem Typ
    for k in CABLE_DATABASE:
        if leitungstyp.upper() in k.upper():
            return k
    # Letzter Fallback
    return "NAYY 150"


@router.post("/api/calculate")
def run_analysis(req: AnalyzeRequest, db: Session = Depends(get_db)):
    # --- Cable-Key auflösen ---
    cable_key = resolve_cable_key(req.leitungstyp, req.querschnitt_mm2)

    # --- Spannung aus Frontend-Auswahl ---
    spannung_kv = float(req.spannungsebene)

    # --- Vorbelastung als bestehende Einspeisung ---
    bestehende_kw = (req.vorbelastung_mw or 0) * 1000.0

    # --- Engine aufrufen ---
    result = berechne_netzcheck(
        typ=req.anlagentyp,
        leistung_kw=req.leistung_kw,
        plz=req.plz,
        spannung_kv=spannung_kv,
        skv_mva=req.skv_mva,
        bestehende_einspeisung_kw=bestehende_kw,
        leitungstyp=cable_key,
        leitungslaenge_km=req.leitungslaenge_km,
    )

    # --- Projekt speichern ---
    project = Project(
        name=req.projektname,
        plz=req.plz,
        typ=req.anlagentyp,
        leistung_kw=req.leistung_kw,
        spannung_kv=spannung_kv,
        einspeiseart=req.einspeiseart,
        skv_mva=req.skv_mva,
        bestehende_einspeisung_kw=bestehende_kw,
        leitungstyp=cable_key,
        leitungslaenge_km=req.leitungslaenge_km,
    )
    db.add(project)
    db.flush()

    # --- CheckResult speichern ---
    check = CheckResult(
        project_id=project.id,
        score=result["score"],
        spannungsband_ok=result["spannungsband_ok"],
        thermische_auslastung_ok=result["thermische_auslastung_ok"],
        kurzschluss_ok=result["kurzschluss_ok"],
        n1_ok=result["n1_ok"],
        netzebene=result["netzebene"],
        empfehlung=result["empfehlung"],
        details=json.dumps(result.get("details", {}), default=str),
    )
    db.add(check)

    # --- Audit-Log (revisionssicher) ---
    audit_data = {
        "request": req.dict(),
        "result": result,
        "cable_resolved": cable_key,
    }
    audit = AuditLog(
        project_id=project.id,
        action="ANALYSIS_COMPLETED",
        detail=json.dumps(audit_data, default=str),
        checksum=make_checksum(audit_data),
    )
    db.add(audit)
    db.commit()

    return {"project_id": project.id, **result}


# Legacy-Endpoint
@router.post("/api/check")
def run_check_legacy(req: AnalyzeRequest, db: Session = Depends(get_db)):
    return run_analysis(req, db)


@router.get("/api/result/{project_id}")
def get_result(project_id: int, db: Session = Depends(get_db)):
    check = db.query(CheckResult).filter(
        CheckResult.project_id == project_id
    ).order_by(CheckResult.id.desc()).first()
    if not check:
        raise HTTPException(status_code=404, detail="Nicht gefunden")
    return {
        "project_id": check.project_id,
        "score": check.score,
        "spannungsband_ok": check.spannungsband_ok,
        "thermische_auslastung_ok": check.thermische_auslastung_ok,
        "kurzschluss_ok": check.kurzschluss_ok,
        "n1_ok": check.n1_ok,
        "netzebene": check.netzebene,
        "empfehlung": check.empfehlung,
        "details": json.loads(check.details) if check.details else {},
    }


@router.get("/api/audit/{project_id}")
def get_audit(project_id: int, db: Session = Depends(get_db)):
    logs = db.query(AuditLog).filter(
        AuditLog.project_id == project_id
    ).order_by(AuditLog.timestamp).all()
    if not logs:
        raise HTTPException(status_code=404, detail="Keine Audit-Logs")
    return [
        {
            "id": l.id,
            "timestamp": str(l.timestamp),
            "action": l.action,
            "detail": l.detail,
            "checksum": l.checksum,
        }
        for l in logs
    ]


@router.get("/api/projects")
def list_projects(db: Session = Depends(get_db)):
    projects = db.query(Project).order_by(Project.created_at.desc()).limit(50).all()
    return [
        {
            "id": p.id,
            "name": p.name,
            "plz": p.plz,
            "typ": p.typ,
            "leistung_kw": p.leistung_kw,
            "created_at": str(p.created_at),
        }
        for p in projects
    ]
