"""
B.5 - API-Tests fuer Revisions-Read-API (read-only, revisionssicher).
Kanonisch: /api/v1/revisions/* (Legacy /api/v2 nur optional).
"""
import pytest
from fastapi.testclient import TestClient
from db.database import SessionLocal
from db.models import User
from main import app
from engine.revision import speichere_revision

client = TestClient(app)
_AUTH_COUNTER = 0


def _admin_headers() -> dict[str, str]:
    global _AUTH_COUNTER
    _AUTH_COUNTER += 1
    email = f"revisions-admin-{_AUTH_COUNTER}@example.com"
    reg = client.post(
        "/api/v1/auth/register",
        json={"email": email, "password": "Passwort123!", "role": "projektierer"},
    )
    assert reg.status_code == 200, reg.text
    db = SessionLocal()
    try:
        user = db.query(User).filter(User.email == email).first()
        assert user is not None
        user.role = "admin"
        db.commit()
    finally:
        db.close()
    login = client.post("/api/v1/auth/login", json={"email": email, "password": "Passwort123!"})
    assert login.status_code == 200, login.text
    return {"Authorization": f"Bearer {login.json()['access_token']}"}


def _seed(n: int = 2):
    """Erzeugt n Revisionen, gibt Liste der Eintraege zurueck."""
    out = []
    for i in range(1, n + 1):
        r = speichere_revision(
            {"input": {"leistung_mw": float(i)}, "result": {"score": i}},
            engine_version="test-1.0.0",
        )
        out.append(r)
    return out


class TestVerifyEndpoint:
    def test_verify_leer(self, isolierte_revisionen):
        r = client.get("/api/v1/revisions/verify", headers=_admin_headers())
        assert r.status_code == 200
        body = r.json()
        assert body["ok"] is True
        assert body["anzahl"] == 0

    def test_verify_mit_eintraegen(self, isolierte_revisionen):
        _seed(3)
        r = client.get("/api/v1/revisions/verify", headers=_admin_headers())
        assert r.status_code == 200
        body = r.json()
        assert body["ok"] is True
        assert body["anzahl"] == 3


class TestCountEndpoint:
    def test_count(self, isolierte_revisionen):
        _seed(2)
        r = client.get("/api/v1/revisions/count", headers=_admin_headers())
        assert r.status_code == 200
        assert r.json()["anzahl"] == 2


class TestGetByHash:
    def test_404_bei_unbekanntem_hash(self, isolierte_revisionen):
        r = client.get("/api/v1/revisions/" + "0" * 64, headers=_admin_headers())
        assert r.status_code == 404

    def test_200_bei_echtem_hash(self, isolierte_revisionen):
        eintraege = _seed(2)
        h = eintraege[0]["hash"]
        r = client.get(f"/api/v1/revisions/{h}", headers=_admin_headers())
        assert r.status_code == 200
        body = r.json()
        assert body["hash"] == h
        assert body["revisionsnummer"] == 1


def test_revisions_endpoints_require_admin(isolierte_revisionen):
    reg = client.post(
        "/api/v1/auth/register",
        json={"email": "revisions-user@example.com", "password": "Passwort123!", "role": "projektierer"},
    )
    assert reg.status_code == 200, reg.text
    login = client.post(
        "/api/v1/auth/login",
        json={"email": "revisions-user@example.com", "password": "Passwort123!"},
    )
    assert login.status_code == 200, login.text
    headers = {"Authorization": f"Bearer {login.json()['access_token']}"}

    forbidden = client.get("/api/v1/revisions/count", headers=headers)
    assert forbidden.status_code == 403
    assert forbidden.json()["detail"]["code"] == "AUTH_FORBIDDEN"
