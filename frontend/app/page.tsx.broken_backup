"use client";

import { useState } from "react";

type CheckResult = {
  status: string;
  ampel?: string;
  diagnose?: string[];
  empfehlungen?: string[];
  n1_ok?: boolean;
  details?: Record<string, unknown>;
  [k: string]: unknown;
};

export default function Home() {
  const [form, setForm] = useState({
    projekt_name: "",
    technologie: "PV",
    leistung_kw: 1000,
    spannungsebene: "MS",
    plz: "",
    netzbetreiber: "",
  });
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState<CheckResult | null>(null);
  const [error, setError] = useState<string | null>(null);

  const update = (k: string, v: string | number) =>
    setForm((s) => ({ ...s, [k]: v }));

  async function runCheck(e: React.FormEvent) {
    e.preventDefault();
    setLoading(true);
    setError(null);
    setResult(null);
    try {
      const res = await fetch("http://127.0.0.1:8000/api/check", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(form),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      setResult(data);
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : "Unbekannter Fehler";
      setError(`Backend nicht erreichbar: ${msg}`);
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="min-h-screen px-6 py-10 max-w-5xl mx-auto">
      {/* Header */}
      <header className="mb-10">
        <div className="flex items-center gap-3 mb-2">
          <div className="w-10 h-10 rounded-lg bg-primary flex items-center justify-center font-bold text-bg">
            AD
          </div>
          <span className="text-text-muted text-sm tracking-wider uppercase">
            ADecarb · GridCheck
          </span>
        </div>
        <h1 className="text-4xl md:text-5xl font-extrabold leading-tight">
          Netzanschluss-Klarheit{" "}
          <span className="text-accent">in Minuten.</span>
        </h1>
        <p className="text-text-muted mt-3 max-w-2xl">
          Strukturierte Vorprüfung für PV-, Speicher- und Energieparkprojekte —
          mit N-1-Analyse, Diagnose und KI-gestützten Empfehlungen.
        </p>
      </header>

      {/* Form */}
      <section className="bg-bg-card border border-border rounded-2xl p-6 md:p-8 shadow-xl">
        <h2 className="text-xl font-semibold mb-6">Projekt prüfen</h2>
        <form onSubmit={runCheck} className="grid md:grid-cols-2 gap-5">
          <Field label="Projektname">
            <input
              required
              value={form.projekt_name}
              onChange={(e) => update("projekt_name", e.target.value)}
              className="input"
              placeholder="z. B. Solarpark Musterstadt"
            />
          </Field>

          <Field label="Technologie">
            <select
              value={form.technologie}
              onChange={(e) => update("technologie", e.target.value)}
              className="input"
            >
              <option value="PV">PV</option>
              <option value="BESS">Batteriespeicher (BESS)</option>
              <option value="Wind">Wind</option>
              <option value="Hybrid">Hybrid (PV + BESS)</option>
            </select>
          </Field>

          <Field label="Leistung (kW)">
            <input
              type="number"
              min={1}
              required
              value={form.leistung_kw}
              onChange={(e) => update("leistung_kw", Number(e.target.value))}
              className="input"
            />
          </Field>

          <Field label="Spannungsebene">
            <select
              value={form.spannungsebene}
              onChange={(e) => update("spannungsebene", e.target.value)}
              className="input"
            >
              <option value="NS">Niederspannung (NS)</option>
              <option value="MS">Mittelspannung (MS)</option>
              <option value="HS">Hochspannung (HS)</option>
              <option value="HöS">Höchstspannung (HöS)</option>
            </select>
          </Field>

          <Field label="PLZ">
            <input
              value={form.plz}
              onChange={(e) => update("plz", e.target.value)}
              className="input"
              placeholder="z. B. 26123"
            />
          </Field>

          <Field label="Netzbetreiber (optional)">
            <input
              value={form.netzbetreiber}
              onChange={(e) => update("netzbetreiber", e.target.value)}
              className="input"
              placeholder="z. B. EWE Netz"
            />
          </Field>

          <div className="md:col-span-2 flex items-center gap-4 pt-2">
            <button
              type="submit"
              disabled={loading}
              className="btn-primary"
            >
              {loading ? "Prüfe…" : "Netzanschluss prüfen"}
            </button>
            <span className="text-text-muted text-sm">
              Ergebnis in der Regel &lt; 5 Sekunden
            </span>
          </div>
        </form>
      </section>

      {/* Error */}
      {error && (
        <div className="mt-6 border border-danger/40 bg-danger/10 text-danger rounded-xl p-4">
          {error}
        </div>
      )}

      {/* Result */}
      {result && (
        <section className="mt-8 bg-bg-card border border-border rounded-2xl p-6 md:p-8">
          <h2 className="text-xl font-semibold mb-4">Diagnose-Ergebnis</h2>
          <pre className="text-sm text-text-muted overflow-auto whitespace-pre-wrap">
{JSON.stringify(result, null, 2)}
          </pre>
        </section>
      )}

      <footer className="mt-16 text-center text-text-muted text-xs">
        © ADecarb Holding GmbH · GridCheck — strukturierte technische Vorprüfung,
        keine finale Netzverträglichkeitsprüfung.
      </footer>

      {/* Local component styles */}
      <style jsx>{`
        :global(.input) {
          width: 100%;
          background: #0E1F1A;
          border: 1px solid #1F3029;
          color: #E8EDE8;
          border-radius: 10px;
          padding: 10px 12px;
          font-size: 14px;
          outline: none;
          transition: border-color 0.15s;
        }
        :global(.input:focus) {
          border-color: #E67A2E;
        }
        :global(.btn-primary) {
          background: #E67A2E;
          color: #0A1410;
          font-weight: 600;
          padding: 12px 22px;
          border-radius: 10px;
          transition: background 0.15s;
        }
        :global(.btn-primary:hover) {
          background: #D26A20;
        }
        :global(.btn-primary:disabled) {
          opacity: 0.6;
          cursor: not-allowed;
        }
      `}</style>
    </main>
  );
}

function Field({
  label,
  children,
}: {
  label: string;
  children: React.ReactNode;
}) {
  return (
    <label className="block">
      <span className="block text-sm text-text-muted mb-1.5">{label}</span>
      {children}
    </label>
  );
}
