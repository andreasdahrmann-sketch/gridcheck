import { ProjectInput, NetzAnalyse } from '../types';

// Spannungsebene automatisch bestimmen
export function bestimmeSpannungsebene(leistung_kw: number): 'NS' | 'MS' | 'HS' | 'HoeS' {
  if (leistung_kw <= 100) return 'NS';
  if (leistung_kw <= 20000) return 'MS';
  if (leistung_kw <= 200000) return 'HS';
  return 'HoeS';
}

// Nennspannung je Ebene (kV)
function nennspannung(ebene: string): number {
  const U: Record<string, number> = { NS: 0.4, MS: 20, HS: 110, HoeS: 380 };
  return U[ebene] || 20;
}

// Scheinleistung S = P / cos_phi
function berechneScheinleistung(leistung_kw: number, cos_phi: number): number {
  return leistung_kw / Math.max(cos_phi, 0.1);
}

// Strom I = S / (sqrt(3) * U)
function berechneStrom(scheinleistung_kva: number, spannung_kv: number): number {
  return scheinleistung_kva / (Math.sqrt(3) * spannung_kv);
}

// Kurzschlussleistung am NVP schaetzen
function schaetzeKurzschlussleistung(spannungsebene: string): number {
  const skWerte: Record<string, number> = { NS: 10, MS: 250, HS: 3000, HoeS: 15000 };
  return skWerte[spannungsebene] || 250;
}

// Kurzschlussanteil: S_Anlage / S_k'' * 100
function berechneKurzschlussanteil(scheinleistung_kva: number, sk_mva: number): number {
  return (scheinleistung_kva / 1000) / sk_mva * 100;
}

// Spannungsaenderung nach VDE-AR-N 4105/4110/4120
function berechneSpannungsaenderung(leistung_kw: number, sk_mva: number): number {
  const leistung_mva = leistung_kw / 1000;
  return (leistung_mva / sk_mva) * 100;
}

// Thermische Auslastung
function berechneThermeAuslastung(leistung_kw: number, kapazitaet_kw: number): number {
  if (kapazitaet_kw <= 0) return 100;
  return (leistung_kw / kapazitaet_kw) * 100;
}

// N-1 Analyse
function pruefeN1(thermische_auslastung: number, spannungsaenderung: number): { ok: boolean; detail: string } {
  const therm_ok = thermische_auslastung <= 60;
  const spann_ok = spannungsaenderung <= 3;
  const ok = therm_ok && spann_ok;

  let detail = '';
  if (ok) {
    detail = 'N-1 erfuellt: Thermische Reserve ' + (60 - thermische_auslastung).toFixed(1) + '%, Spannungsreserve ' + (3 - spannungsaenderung).toFixed(2) + '%';
  } else {
    const gruende: string[] = [];
    if (!therm_ok) gruende.push('Thermische Auslastung ' + thermische_auslastung.toFixed(1) + '% > 60% (N-1 Grenze)');
    if (!spann_ok) gruende.push('Spannungsaenderung ' + spannungsaenderung.toFixed(2) + '% > 3% Grenzwert');
    detail = 'N-1 kritisch: ' + gruende.join('; ');
  }
  return { ok, detail };
}

// Kosten-Indikation
function schaetzeKosten(leistung_kw: number, spannungsebene: string, netzausbau: boolean, entfernung_km: number): number {
  const basiskosten: Record<string, number> = { NS: 5000, MS: 50000, HS: 500000, HoeS: 5000000 };
  let kosten = basiskosten[spannungsebene] || 50000;
  kosten += entfernung_km * (spannungsebene === 'NS' ? 30000 : spannungsebene === 'MS' ? 80000 : 200000);
  if (netzausbau) kosten *= 2.5;
  kosten += leistung_kw * (spannungsebene === 'NS' ? 5 : 2);
  return Math.round(kosten);
}

function bestimmeKostenklasse(kosten: number): 'gering' | 'mittel' | 'hoch' | 'sehr_hoch' {
  if (kosten < 20000) return 'gering';
  if (kosten < 100000) return 'mittel';
  if (kosten < 500000) return 'hoch';
  return 'sehr_hoch';
}

function schaetzeBearbeitungszeit(spannungsebene: string, netzausbau: boolean): number {
  const basis: Record<string, number> = { NS: 4, MS: 8, HS: 16, HoeS: 26 };
  let wochen = basis[spannungsebene] || 8;
  if (netzausbau) wochen *= 2;
  return wochen;
}

// Empfehlungen generieren
function generiereEmpfehlungen(input: ProjectInput, analyse: Partial<NetzAnalyse>): string[] {
  const empfehlungen: string[] = [];
  if ((analyse.spannungsaenderung_prozent || 0) > 2) {
    empfehlungen.push('Blindleistungskompensation (cos phi Regelung) empfohlen');
  }
  if ((analyse.thermische_auslastung_prozent || 0) > 50) {
    empfehlungen.push('Einspeisemanagement / Wirkleistungsreduzierung pruefen');
  }
  if (!analyse.n1_sicher) {
    empfehlungen.push('N-1 Kriterium nicht erfuellt - Netzverstaerkung erforderlich');
  }
  if (input.erzeugungstyp === 'PV' && input.anschlussleistung_kw > 135) {
    empfehlungen.push('Direktvermarktung nach Paragraph 21b EEG erforderlich');
  }
  if (input.erzeugungstyp === 'BESS') {
    empfehlungen.push('Speicher-Praequalizierung fuer Regelenergiemarkt pruefen');
  }
  if (input.anschlussleistung_kw > 1000) {
    empfehlungen.push('Netzvertraeglichkeitspruefung durch Netzbetreiber erforderlich');
  }
  if ((analyse.nvp_freie_kapazitaet_kw || 0) < input.anschlussleistung_kw) {
    empfehlungen.push('Kapazitaet am NVP nicht ausreichend - alternativen NVP pruefen');
  }
  return empfehlungen;
}

function ermittleEinschraenkungen(input: ProjectInput, analyse: Partial<NetzAnalyse>): string[] {
  const einschraenkungen: string[] = [];
  if ((analyse.spannungsaenderung_prozent || 0) > 3) {
    einschraenkungen.push('Spannungsaenderung ueberschreitet Grenzwert');
  }
  if ((analyse.thermische_auslastung_prozent || 0) > 80) {
    einschraenkungen.push('Thermische Belastungsgrenze kritisch');
  }
  if (!analyse.n1_sicher) {
    einschraenkungen.push('N-1 Sicherheit nicht gewaehrleistet');
  }
  if ((analyse.nvp_freie_kapazitaet_kw || 0) < input.anschlussleistung_kw * 0.5) {
    einschraenkungen.push('Erheblicher Netzausbau notwendig');
  }
  return einschraenkungen;
}

// Score berechnen (0-100)
function berechneScore(analyse: Partial<NetzAnalyse>): number {
  let score = 100;
  const therm = analyse.thermische_auslastung_prozent || 0;
  if (therm > 40) score -= Math.min(30, (therm - 40) * 0.5);
  const spannung = analyse.spannungsaenderung_prozent || 0;
  if (spannung > 1) score -= Math.min(30, (spannung - 1) * 15);
  if (!analyse.n1_sicher) score -= 25;
  if (analyse.netzausbau_erforderlich) score -= 15;
  return Math.max(0, Math.round(score));
}

// === HAUPT-ANALYSE-FUNKTION ===
export function berechneNetzanalyse(input: ProjectInput): NetzAnalyse {
  const spannungsebene = input.spannungsebene || bestimmeSpannungsebene(input.anschlussleistung_kw);
  const U_kv = nennspannung(spannungsebene);

  // NVP simulieren
  const nvp_entfernung = input.entfernung_umspannwerk_km ?? (Math.random() * 3 + 0.5);
  const sk_mva = schaetzeKurzschlussleistung(spannungsebene);

  // Kapazitaet am NVP
  const kapFaktor = 15000;
  const nvp_kapazitaet = kapFaktor * (0.3 + Math.random() * 0.7);

  // Elektrische Kenngroessen
  const wirkleistung = input.anschlussleistung_kw * input.gleichzeitigkeitsfaktor;
  const scheinleistung_kva = berechneScheinleistung(wirkleistung, input.cos_phi);
  const strom_a = berechneStrom(scheinleistung_kva, U_kv);
  const kurzschluss_anteil_pct = berechneKurzschlussanteil(scheinleistung_kva, sk_mva);

  // Netzberechnungen
  const spannungsaenderung = berechneSpannungsaenderung(wirkleistung, sk_mva);
  const thermische_auslastung = berechneThermeAuslastung(input.anschlussleistung_kw, nvp_kapazitaet);
  const n1 = pruefeN1(thermische_auslastung, spannungsaenderung);
  const netzausbau = !n1.ok || thermische_auslastung > 70 || nvp_kapazitaet < input.anschlussleistung_kw;

  const partialAnalyse: Partial<NetzAnalyse> = {
    spannungsaenderung_prozent: Math.round(spannungsaenderung * 100) / 100,
    thermische_auslastung_prozent: Math.round(thermische_auslastung * 100) / 100,
    n1_sicher: n1.ok,
    nvp_freie_kapazitaet_kw: Math.round(nvp_kapazitaet),
    netzausbau_erforderlich: netzausbau
  };

  const kosten = schaetzeKosten(input.anschlussleistung_kw, spannungsebene, netzausbau, nvp_entfernung);
  const score = berechneScore(partialAnalyse);
  const empfehlungen = generiereEmpfehlungen(input, partialAnalyse);
  const einschraenkungen = ermittleEinschraenkungen(input, partialAnalyse);

  return {
    machbar: score >= 30,
    einschraenkungen,
    empfehlungen,

    // Elektrische Kenngroessen
    scheinleistung_kva: Math.round(scheinleistung_kva * 10) / 10,
    strom_a: Math.round(strom_a * 10) / 10,
    spannungsaenderung_pct: Math.round(spannungsaenderung * 100) / 100,
    kurzschluss_anteil_pct: Math.round(kurzschluss_anteil_pct * 100) / 100,

    // Technische Bewertung
    kurzschlussleistung_mva: sk_mva,
    thermische_auslastung_prozent: partialAnalyse.thermische_auslastung_prozent!,
    spannungsaenderung_prozent: partialAnalyse.spannungsaenderung_prozent!,
    n1_sicher: n1.ok,
    n1_ok: n1.ok,
    n1_detail: n1.detail,

    // NVP
    nvp_bezeichnung: 'NVP-' + input.plz + '-' + spannungsebene,
    nvp_entfernung_km: Math.round(nvp_entfernung * 10) / 10,
    nvp_freie_kapazitaet_kw: partialAnalyse.nvp_freie_kapazitaet_kw!,

    // Kosten
    kosten_indikation_eur: kosten,
    kostenklasse: bestimmeKostenklasse(kosten),

    // Zeit
    geschaetzte_bearbeitungszeit_wochen: schaetzeBearbeitungszeit(spannungsebene, netzausbau),
    netzausbau_erforderlich: netzausbau,

    // Score
    score,
    konfidenz: 45
  };
}

export const runGridCheck = berechneNetzanalyse;


