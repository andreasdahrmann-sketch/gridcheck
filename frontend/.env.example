# =============================================================================
# Vercel / Production (canonical)
# =============================================================================
#
# BACKEND_URL — dringend empfohlen auf Vercel. Der Build bricht ohne Wert NICHT ab:
# next.config.mjs faellt bei VERCEL=1 still auf einen hart verdrahteten Prod-Host zurueck
# (console.warn). Ein Preview-Deployment ohne eigenen Wert zeigt damit gegen Produktion.
# Ein gesetzter, aber falsch formatierter Wert bricht den Build ab (siehe Regeln unten).
# Server-side rewrite: browser calls /api/backend/* → BACKEND_URL/*
# Auth (register/login): /api/auth/* → Route Handler → BACKEND_URL (siehe app/api/auth/)
# Set ONLY the backend origin (no path suffix):
#
#   BACKEND_URL=https://your-service.up.railway.app
#   BACKEND_URL=https://api.gridcheck.de
#
# NOT used (do not set on Vercel):
#   NEXT_PUBLIC_API_URL, NEXT_PUBLIC_BACKEND_URL, VITE_API_URL
#
BACKEND_URL=http://localhost:8000

# Lokale Verifikation (Frontend: npm run dev, Backend: uvicorn auf :8000):
#   1. http://localhost:3000/api-test  → Health OK
#   2. Registrierung auf /register oder api-test „Register-Probe“
# Vercel/Railway nach ENV-Aenderung: Redeploy Frontend + Backend.
# BACKEND_URL = nur Origin (https://…railway.app oder https://api.gridcheck.de), kein /api/v1.
# Railway TRUSTED_HOSTS muss den Host aus BACKEND_URL enthalten (z. B. *.up.railway.app).

# Browser always talks to same origin; Next.js proxies to BACKEND_URL.
# Leave at default unless you have a deliberate custom proxy path.
NEXT_PUBLIC_API_BASE=/api/backend

# App metadata
NEXT_PUBLIC_APP_NAME=GridCheck
NEXT_PUBLIC_APP_VERSION=0.1.0

# Mapbox for network map / PLZ geocoding
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_ID=mapbox/dark-v11

# Rechtliche Platzhalter (Datenschutz/AGB) — vor Live setzen
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_COMPANY_FORM=
NEXT_PUBLIC_LEGAL_STREET=
NEXT_PUBLIC_LEGAL_CITY=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=
