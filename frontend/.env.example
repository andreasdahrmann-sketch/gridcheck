# Absolute Backend-Basis-URL fuer den serverseitigen Next.js-/Vercel-Rewrite.
# Lokal: http://localhost:8000
# Deploy: https://api.gridcheck.de oder https://your-backend.up.railway.app
BACKEND_URL=http://localhost:8000

# App-Metadaten
NEXT_PUBLIC_APP_NAME=GridCheck
NEXT_PUBLIC_APP_VERSION=0.1.0

# Browser spricht immer denselben Origin an; Next.js/Vercel rewritet serverseitig zum Backend.
# Im Normalfall unveraendert lassen.
NEXT_PUBLIC_API_BASE=/api/backend

# Mapbox fuer Netzplan-Kartenausschnitt / PLZ-Geocoding
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_ID=mapbox/dark-v11
