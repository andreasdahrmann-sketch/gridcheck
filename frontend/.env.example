# =============================================================================
# Vercel / Production (canonical)
# =============================================================================
#
# BACKEND_URL — REQUIRED on Vercel (build fails without it).
# Server-side rewrite: browser calls /api/backend/* → BACKEND_URL/*
# Set ONLY the backend origin (no path suffix):
#
#   BACKEND_URL=https://your-service.up.railway.app
#   BACKEND_URL=https://api.gridcheck.de
#
# NOT used (do not set on Vercel):
#   NEXT_PUBLIC_API_URL, NEXT_PUBLIC_BACKEND_URL, VITE_API_URL
#
BACKEND_URL=http://localhost:8000

# Browser always talks to same origin; Next.js proxies to BACKEND_URL.
# Leave at default unless you have a deliberate custom proxy path.
NEXT_PUBLIC_API_BASE=/api/backend

# App metadata
NEXT_PUBLIC_APP_NAME=GridCheck
NEXT_PUBLIC_APP_VERSION=0.1.0

# Mapbox for network map / PLZ geocoding
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_ID=mapbox/dark-v11
